{
  "name": "unclaimed-bloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "spore": "./dist/cli/spore.js"
  },
  "scripts": {
    "spore": "tsx src/cli/spore.ts",
    "dev": "npm run dev:workbench",
    "dev:workbench": "concurrently --names server,ui --prefix-colors cyan,magenta \"npm run dev:workbench:server\" \"npm run dev:workbench:ui\"",
    "dev:workbench:server": "UB_DATA_DIR=$(pwd) tsx watch src/server/workbench.ts",
    "dev:workbench:ui": "vite",
    "workbench": "npm run dev:workbench",
    "build:cli": "tsup src/cli/spore.ts --format esm --dts --out-dir dist/cli",
    "typecheck": "tsc --noEmit && tsc --project src/ui/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
