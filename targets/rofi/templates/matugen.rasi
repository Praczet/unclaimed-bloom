/* Generated by Unclaimed Bloom (Deno template) */
* {
    font:           "GeistMono Nerd Font Propo 13";
    background:     {{background|rgba:0.75}};
    background-alt: {{background_alt}};
    foreground:     {{foreground}};
    accent1:        {{accent1}};
    selected:       {{selected}};
    active:         {{active}};
    urgent:         {{urgent}};
}
