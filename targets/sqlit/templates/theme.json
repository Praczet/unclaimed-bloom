      "block-hover-background":          "{{panel}}",
      "surface-active":                  "{{panel}}",
      "footer-foreground":               "{{foreground}}",
      "footer-key-background":           "{{panel}}",
      "footer-item-background":          "{{panel}}",
      "footer-description-background":   "{{panel}}",
      "input-cursor-background":         "{{primary}}",
      "input-cursor-foreground":         "{{background}}",
      "screen-selection-background":     "{{selection_bg}} 60%",
      "screen-selection-foreground":     "{{foreground}}",
      "link-color-hover":                "{{accent}}",
      "link-background-hover":           "{{panel}}",
      "text-muted":                      "{{muted}}",
      "text-disabled":                   "{{disabled}}",
      "foreground-muted":                "{{muted}}",
      "foreground-disabled":             "{{disabled}}"
