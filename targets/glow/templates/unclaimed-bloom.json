{
  "//": "Generated by Unclaimed Bloom / spore. Glamour style for glow, based on glamour's dark.json.",
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{fg}}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "{{fg_dim}}",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{command}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{bg}}",
    "background_color": "{{command}}",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "{{keyword}}"
  },
  "h3": {
    "prefix": "### ",
    "color": "{{alias}}"
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{muted}}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "{{keyword}}"
  },
  "strong": {
    "bold": true,
    "color": "{{escape}}"
  },
  "hr": {
    "color": "{{border}}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{alias}}",
    "underline": true
  },
  "link_text": {
    "color": "{{command}}",
    "bold": true
  },
  "image": {
    "color": "{{path}}",
    "underline": true
  },
  "image_text": {
    "color": "{{muted}}",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{string}}",
    "background_color": "{{raised_bg}}"
  },
  "code_block": {
    "color": "{{fg_dim}}",
    "margin": 2,
    "chroma": {
      "text": { "color": "{{fg}}" },
      "error": { "color": "{{bg}}", "background_color": "{{danger}}" },
      "comment": { "color": "{{muted}}", "italic": true },
      "comment_preproc": { "color": "{{escape}}" },
      "keyword": { "color": "{{keyword}}" },
      "keyword_reserved": { "color": "{{keyword}}" },
      "keyword_namespace": { "color": "{{keyword}}" },
      "keyword_type": { "color": "{{builtin}}" },
      "operator": { "color": "{{operator}}" },
      "punctuation": { "color": "{{fg_dim}}" },
      "name": { "color": "{{fg}}" },
      "name_builtin": { "color": "{{builtin}}" },
      "name_tag": { "color": "{{danger}}" },
      "name_attribute": { "color": "{{variable}}" },
      "name_class": { "color": "{{builtin}}", "bold": true },
      "name_constant": { "color": "{{number}}" },
      "name_decorator": { "color": "{{variable}}" },
      "name_exception": { "color": "{{danger}}" },
      "name_function": { "color": "{{function}}" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "{{number}}" },
      "literal_date": { "color": "{{number}}" },
      "literal_string": { "color": "{{string}}" },
      "literal_string_escape": { "color": "{{escape}}" },
      "generic_deleted": { "color": "{{danger}}" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "{{success}}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "{{muted}}" },
      "background": { "background_color": "{{raised_bg}}" }
    }
  },
  "table": {
    "color": "{{fg}}"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
