# Generated by Unclaimed Bloom / spore.
# Do not edit this file directly unless you enjoy losing arguments with automation.
#
# Shell colours that are not fast-syntax-highlighting: autosuggestions,
# man pages through less, and fzf. Sourced from themes.zsh, after fzf.zsh.

# "#rrggbb" -> "r;g;b" for truecolor escape sequences
_ub_rgb() {
  local h=${1#\#}
  print -rn -- "$((16#${h[1,2]}));$((16#${h[3,4]}));$((16#${h[5,6]}))"
}

# zsh-autosuggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg={{suggestion}}"

# Man pages (less termcap)
export LESS_TERMCAP_mb=$'\e[1;38;2;'"$(_ub_rgb '{{danger}}')"'m'      # blink -> danger
export LESS_TERMCAP_md=$'\e[1;38;2;'"$(_ub_rgb '{{command}}')"'m'     # bold -> headings, flags
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_so=$'\e[38;2;'"$(_ub_rgb '{{fg}}')"';48;2;'"$(_ub_rgb '{{selection_bg}}')"'m' # standout -> status line, search
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_us=$'\e[4;38;2;'"$(_ub_rgb '{{string}}')"'m'      # underline -> arguments
export LESS_TERMCAP_ue=$'\e[0m'

# fzf: background stays the terminal's own (-1)
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS
  --color=fg:{{fg_dim}},bg:-1,hl:{{warning}}
  --color=fg+:{{fg}},bg+:{{selection_bg}},hl+:{{warning}}
  --color=info:{{muted}},prompt:{{command}},pointer:{{keyword}}
  --color=marker:{{success}},spinner:{{alias}},header:{{alias}}
  --color=border:{{border}},label:{{command}},query:{{fg}}
  --color=separator:{{border}},scrollbar:{{border}},gutter:-1
  --color=preview-border:{{border}},preview-label:{{command}}"

unfunction _ub_rgb
