<plist version="1.0">
<dict>
  <key>name</key>
  <string>unclaimed-bloom</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>{{bg}}</string>
        <key>foreground</key><string>{{fg}}</string>
        <key>caret</key><string>{{function}}</string>
        <key>selection</key><string>{{selection_bg}}</string>
        <key>lineHighlight</key><string>{{line_bg}}</string>
        <key>gutter</key><string>{{bg}}</string>
        <key>gutterForeground</key><string>{{muted}}</string>
        <key>invisibles</key><string>{{border}}</string>
        <key>findHighlight</key><string>{{warning}}</string>
        <key>findHighlightForeground</key><string>{{bg}}</string>
      </dict>
    </dict>

    <!-- Comments -->
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>{{muted}}</string><key>fontStyle</key><string>italic</string></dict>
    </dict>

    <!-- Keywords, storage -->
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, storage, storage.type, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>{{keyword}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.separator.key-value, punctuation.accessor</string>
      <key>settings</key><dict><key>foreground</key><string>{{operator}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Punctuation</string>
      <key>scope</key><string>punctuation, meta.brace, meta.delimiter</string>
      <key>settings</key><dict><key>foreground</key><string>{{fg_dim}}</string></dict>
    </dict>

    <!-- Strings -->
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>{{string}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String escape, regexp</string>
      <key>scope</key><string>constant.character.escape, string.regexp, constant.other.placeholder</string>
      <key>settings</key><dict><key>foreground</key><string>{{escape}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Interpolation</string>
      <key>scope</key><string>punctuation.section.interpolation, punctuation.definition.template-expression, meta.interpolation</string>
      <key>settings</key><dict><key>foreground</key><string>{{keyword}}</string></dict>
    </dict>

    <!-- Constants -->
    <dict>
      <key>name</key><string>Number, constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.other, support.constant</string>
      <key>settings</key><dict><key>foreground</key><string>{{number}}</string></dict>
    </dict>

    <!-- Functions, types -->
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, meta.function-call, support.function, variable.function</string>
      <key>settings</key><dict><key>foreground</key><string>{{function}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class, storage.type.primitive</string>
      <key>settings</key><dict><key>foreground</key><string>{{type}}</string></dict>
    </dict>

    <!-- Variables -->
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.other</string>
      <key>settings</key><dict><key>foreground</key><string>{{fg}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Parameter</string>
      <key>scope</key><string>variable.parameter, meta.parameter</string>
      <key>settings</key><dict><key>foreground</key><string>{{variable}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Language variable</string>
      <key>scope</key><string>variable.language, variable.other.readwrite.global, punctuation.definition.variable</string>
      <key>settings</key><dict><key>foreground</key><string>{{danger}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Property</string>
      <key>scope</key><string>variable.other.property, variable.other.member, meta.property-name, support.type.property-name, entity.name.tag.yaml, meta.mapping.key string</string>
      <key>settings</key><dict><key>foreground</key><string>{{property}}</string></dict>
    </dict>

    <!-- Markup tags -->
    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag, punctuation.definition.tag</string>
      <key>settings</key><dict><key>foreground</key><string>{{tag}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Attribute</string>
      <key>scope</key><string>entity.other.attribute-name</string>
      <key>settings</key><dict><key>foreground</key><string>{{variable}}</string></dict>
    </dict>

    <!-- Markdown and friends -->
    <dict>
      <key>name</key><string>Heading</string>
      <key>scope</key><string>markup.heading, entity.name.section, punctuation.definition.heading</string>
      <key>settings</key><dict><key>foreground</key><string>{{function}}</string><key>fontStyle</key><string>bold</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Bold</string>
      <key>scope</key><string>markup.bold</string>
      <key>settings</key><dict><key>foreground</key><string>{{number}}</string><key>fontStyle</key><string>bold</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Italic</string>
      <key>scope</key><string>markup.italic</string>
      <key>settings</key><dict><key>foreground</key><string>{{keyword}}</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Link</string>
      <key>scope</key><string>markup.underline.link, string.other.link, meta.link</string>
      <key>settings</key><dict><key>foreground</key><string>{{property}}</string><key>fontStyle</key><string>underline</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inline code</string>
      <key>scope</key><string>markup.raw, markup.inline.raw</string>
      <key>settings</key><dict><key>foreground</key><string>{{string}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Quote, list</string>
      <key>scope</key><string>markup.quote, punctuation.definition.list_item, markup.list punctuation</string>
      <key>settings</key><dict><key>foreground</key><string>{{type}}</string></dict>
    </dict>

    <!-- Diffs -->
    <dict>
      <key>name</key><string>Inserted</string>
      <key>scope</key><string>markup.inserted, meta.diff.header.to-file, punctuation.definition.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>{{success}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Deleted</string>
      <key>scope</key><string>markup.deleted, meta.diff.header.from-file, punctuation.definition.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>{{danger}}</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Changed</string>
      <key>scope</key><string>markup.changed, meta.diff.range, meta.diff.header</string>
      <key>settings</key><dict><key>foreground</key><string>{{warning}}</string></dict>
    </dict>

    <!-- Errors -->
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal, invalid.deprecated</string>
      <key>settings</key><dict><key>foreground</key><string>{{danger}}</string><key>fontStyle</key><string>underline</string></dict>
    </dict>
  </array>
</dict>
</plist>
