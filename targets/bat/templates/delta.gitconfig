# Generated by Unclaimed Bloom / spore.
# Do not edit this file directly unless you enjoy losing arguments with automation.
#
# delta feature: included from ~/.gitconfig, enabled with
#   [delta] features = ... unclaimed-bloom

[delta "unclaimed-bloom"]
    syntax-theme = unclaimed-bloom
    plus-style = syntax "{{plus_bg}}"
    plus-emph-style = syntax "{{plus_emph_bg}}"
    minus-style = syntax "{{minus_bg}}"
    minus-emph-style = syntax "{{minus_emph_bg}}"
    line-numbers-plus-style = "{{success}}"
    line-numbers-minus-style = "{{danger}}"
    line-numbers-zero-style = "{{muted}}"
    line-numbers-left-style = "{{border}}"
    line-numbers-right-style = "{{border}}"
