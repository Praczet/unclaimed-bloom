# Generated by Unclaimed Bloom / spore.
# Do not edit this file directly unless you enjoy losing arguments with automation.
# Enabled by color_theme = "unclaimed-bloom" in ~/.config/btop/btop.conf.
# Empty *_mid values make a two-colour gradient.

# Main background, empty for terminal default
theme[main_bg]="{{bg}}"

# Main text color
theme[main_fg]="{{fg}}"

# Title color for boxes
theme[title]="{{fg}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{command}}"

# Background color of selected item in processes box
theme[selected_bg]="{{selection_bg}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{fg}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{muted}}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{fg_dim}}"

# Background color of the percentage meters
theme[meter_bg]="{{raised_bg}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{alias}}"

# Box outline colors
theme[cpu_box]="{{border}}"
theme[mem_box]="{{border}}"
theme[net_box]="{{border}}"
theme[proc_box]="{{border}}"

# Box divider line and small boxes line color
theme[div_line]="{{border}}"

# Temperature graph
theme[temp_start]="{{success}}"
theme[temp_mid]="{{warning}}"
theme[temp_end]="{{danger}}"

# CPU graph
theme[cpu_start]="{{command}}"
theme[cpu_mid]="{{keyword}}"
theme[cpu_end]="{{danger}}"

# Mem/Disk free meter
theme[free_start]="{{success}}"
theme[free_mid]=""
theme[free_end]="{{alias}}"

# Mem/Disk cached meter
theme[cached_start]="{{option}}"
theme[cached_mid]=""
theme[cached_end]="{{command}}"

# Mem/Disk available meter
theme[available_start]="{{warning}}"
theme[available_mid]=""
theme[available_end]="{{escape}}"

# Mem/Disk used meter
theme[used_start]="{{escape}}"
theme[used_mid]=""
theme[used_end]="{{danger}}"

# Download graph
theme[download_start]="{{command}}"
theme[download_mid]=""
theme[download_end]="{{keyword}}"

# Upload graph
theme[upload_start]="{{alias}}"
theme[upload_mid]=""
theme[upload_end]="{{success}}"

# Process box gradient
theme[process_start]="{{command}}"
theme[process_mid]="{{keyword}}"
theme[process_end]="{{danger}}"
