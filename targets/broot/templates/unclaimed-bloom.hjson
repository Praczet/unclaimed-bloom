###############################################################
# Unclaimed Bloom skin for broot
# Generated by spore — do not edit directly
# Docs: https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: {{fg}} None / {{fg}} {{bg_selected}}
    tree: {{border}} None / {{bg_selected}} None
    parent: {{fg}} None Italic / {{fg}} {{bg_selected}} Italic
    file: {{fg_muted}} None / {{fg}} None Italic
    directory: {{accent}} None Bold / {{accent}} None
    exe: {{success}} None
    link: {{accent3}} None
    pruning: {{fg_dim}} None Italic

    # permissions
    perm__: {{fg_muted}} None
    perm_r: {{info}} None
    perm_w: {{success}} None
    perm_x: {{accent3}} None
    owner: {{accent}} None Bold
    group: {{accent2}} None

    count: {{info}} {{bg_alt}}
    dates: {{fg_muted}} None
    sparse: {{warning}} None

    content_extract: {{info}} None Italic
    content_match: {{accent}} None Bold

    # git
    git_branch: {{accent3}} None
    git_insertions: {{success}} None
    git_deletions: {{danger}} None
    git_status_current: {{fg_muted}} None
    git_status_modified: {{warning}} None
    git_status_new: {{success}} None Bold
    git_status_ignored: {{fg_dim}} None
    git_status_conflicted: {{danger}} None
    git_status_other: {{danger}} None

    # highlighting
    selected_line: None {{bg_selected}} / None {{bg_selected}}
    char_match: {{warning}} None
    file_error: {{danger}} None

    flag_label: {{fg_muted}} None
    flag_value: {{accent3}} None Bold

    input: {{fg}} {{bg_alt}} / {{fg}} {{bg_alt}} Italic

    # status bar
    status_error: {{fg}} {{danger}}
    status_job: {{bg}} {{warning}}
    status_normal: {{fg_muted}} {{bg_alt}} / None None
    status_italic: {{accent3}} {{bg_alt}} Italic / None None
    status_bold: {{accent3}} {{bg_alt}} Bold / None None
    status_code: {{fg}} {{bg_alt}} / None None
    status_ellipsis: {{fg}} {{bg_alt}} Bold / None None

    purpose_normal: None None
    purpose_italic: {{accent}} None Italic
    purpose_bold: {{accent}} None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: {{border}} None / {{bg_alt}} None
    scrollbar_thumb: {{fg}} None / {{fg_muted}} None

    # documentation
    help_paragraph: None None
    help_bold: {{warning}} None Bold
    help_italic: {{accent3}} None Italic
    help_code: {{success}} {{bg_alt}}

    # preview panel
    preview_title: {{fg}} {{bg_alt}} / {{fg_muted}} {{bg_alt}}
    preview: None None / None None
    preview_line_number: {{fg_dim}} {{bg_alt}} / {{fg_dim}} None
    preview_separator: {{border}} None / {{bg_selected}} None
    preview_match: None {{warning}} Bold

    hex_null: {{fg_muted}} None
    hex_ascii_graphic: {{fg}} None
    hex_ascii_whitespace: {{fg_dim}} None
    hex_ascii_other: {{warning}} None
    hex_non_ascii: {{danger}} None

    staging_area_title: {{fg}} {{bg_alt}} / {{fg_muted}} {{bg_alt}}

    mode_command_mark: {{bg}} {{accent3}} Bold

    # file system occupation
    good_to_bad_0: {{success}}
    good_to_bad_1: {{success}}
    good_to_bad_2: {{success}}
    good_to_bad_3: {{success}}
    good_to_bad_4: {{warning}}
    good_to_bad_5: {{warning}}
    good_to_bad_6: {{warning}}
    good_to_bad_7: {{warning}}
    good_to_bad_8: {{warning}}
    good_to_bad_9: {{warning}}
}
