{
  "steps": [
    {
      "type": "worker",
      "command": "~/.local/bin/adart-worker",
      "args": [
        "--runtime",  "{{rendered}}",
        "--output",   "~/.local/share/icons/adart",
        "--force",
        "--json-progress"
      ]
    },
    {
      "type": "exec",
      "command": "gsettings",
      "args": ["set", "org.gnome.desktop.interface", "icon-theme", "adart"]
    }
  ]
}
