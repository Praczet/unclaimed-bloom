{
  "steps": [
    {
      "type": "copy",
      "dest": [
        "~/.config/potato/theme.json"
      ]
    },
    {
      "type": "exec",
      "command": "potato-sync",
      "args": [
        "--no-reload-ags"
      ]
    },
    {
      "type": "exec",
      "command": "bash",
      "args": [
        "-c",
        "ags-ensure --reload || true"
      ]
    }
  ]
}
