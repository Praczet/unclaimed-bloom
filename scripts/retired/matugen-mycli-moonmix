#!/usr/bin/env python3
# %name: matugen-mycli-moonmix
# %desc: Generate a mycli [colors] section by tinting Tokyonight Moon with a Matugen palette.
# %icon: palette
# %terminal: true
# %categories: theme,terminal,database
# %mode: cli
# %tags: matugen,mycli,tokyonight-moon,mariadb,mysql,colors,theme
# %usage: matugen-mycli-moonmix --palette ~/.cache/matugen/mycli-palette.json --output ~/.cache/matugen/mycli-colors.ini
# %deps: python3
# %safe: yes
"""
matugen-mycli-moonmix.py

Generate a mycli [colors] section by mixing Tokyonight Moon with a Matugen palette.

Why this exists:
    Pure Matugen follows the wallpaper.
    Tokyonight Moon remains readable and calm.
    This script keeps Tokyonight Moon as the spine and lets Matugen tint the mood.
    Which is how civilization survives wallpaper changes.

Expected input:
    A small JSON file generated by Matugen from mycli-palette.json.template.

Example:
    matugen-mycli-moonmix \
      --palette ~/.cache/matugen/mycli-palette.json \
      --output ~/.cache/matugen/mycli-colors.ini
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path


TOKYO_MOON = {
    "bg": "#222436",
    "bg_dark": "#1e2030",
    "bg_highlight": "#2f334d",
    "bg_sidebar": "#1b1d2b",
    "fg": "#c8d3f5",
    "fg_dark": "#828bb8",
    "comment": "#636da6",
    "blue": "#82aaff",
    "cyan": "#86e1fc",
    "green": "#c3e88d",
    "yellow": "#ffc777",
    "orange": "#ff966c",
    "red": "#ff757f",
    "magenta": "#c099ff",
    "purple": "#fca7ea",
}


def clamp(value: float, low: int = 0, high: int = 255) -> int:
    return max(low, min(high, round(value)))


def hex_to_rgb(hex_color: str) -> tuple[int, int, int]:
    value = hex_color.strip().lstrip("#")
    if len(value) != 6:
        raise ValueError(f"Expected #RRGGBB color, got {hex_color!r}")
    return int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16)


def rgb_to_hex(rgb: tuple[int, int, int]) -> str:
    return "#{:02x}{:02x}{:02x}".format(*rgb)


def mix(base: str, tint: str, tint_weight: float) -> str:
    """
    Mix two colors in simple sRGB.

    tint_weight:
        0.0 = pure base
        1.0 = pure tint

    This mirrors the Ghostty moonmix script: predictable beats fancy.
    Fancy can sit in the corner and think about what it did.
    """
    br, bg, bb = hex_to_rgb(base)
    tr, tg, tb = hex_to_rgb(tint)
    return rgb_to_hex((
        clamp(br * (1 - tint_weight) + tr * tint_weight),
        clamp(bg * (1 - tint_weight) + tg * tint_weight),
        clamp(bb * (1 - tint_weight) + tb * tint_weight),
    ))


def pick(palette: dict[str, str], key: str, fallback: str) -> str:
    value = palette.get(key) or fallback
    if not isinstance(value, str):
        return fallback
    return value


def quote(style: str) -> str:
    return f"'{style}'"


def build_colors(palette: dict[str, str], mix_weight: float) -> dict[str, str]:
    m = lambda tokyo_key, matugen_key, weight=mix_weight: mix(
        TOKYO_MOON[tokyo_key],
        pick(palette, matugen_key, TOKYO_MOON[tokyo_key]),
        weight,
    )

    bg = mix(TOKYO_MOON["bg"], pick(palette, "background", TOKYO_MOON["bg"]), 0.24)
    bg_dark = mix(TOKYO_MOON["bg_dark"], pick(palette, "surface", TOKYO_MOON["bg_dark"]), 0.22)
    bg_high = mix(TOKYO_MOON["bg_highlight"], pick(palette, "surface_container_high", TOKYO_MOON["bg_highlight"]), 0.32)
    bg_selected = mix(TOKYO_MOON["bg_highlight"], pick(palette, "primary_container", TOKYO_MOON["bg_highlight"]), 0.45)
    bg_meta = mix(TOKYO_MOON["bg_highlight"], pick(palette, "secondary_container", TOKYO_MOON["bg_highlight"]), 0.38)

    fg = mix(TOKYO_MOON["fg"], pick(palette, "on_surface", TOKYO_MOON["fg"]), 0.28)
    fg_muted = mix(TOKYO_MOON["fg_dark"], pick(palette, "on_surface_variant", TOKYO_MOON["fg_dark"]), 0.32)
    comment = mix(TOKYO_MOON["comment"], pick(palette, "outline", TOKYO_MOON["comment"]), 0.32)

    blue = m("blue", "primary", 0.46)
    cyan = m("cyan", "tertiary", 0.34)
    green = m("green", "primary", 0.30)
    yellow = m("yellow", "tertiary", 0.32)
    red = m("red", "error", 0.42)
    magenta = m("magenta", "secondary", 0.38)
    purple = m("purple", "tertiary", 0.30)

    on_primary = mix(TOKYO_MOON["fg"], pick(palette, "on_primary_container", TOKYO_MOON["fg"]), 0.35)
    on_secondary = mix(TOKYO_MOON["fg"], pick(palette, "on_secondary_container", TOKYO_MOON["fg"]), 0.35)
    on_tertiary = mix(TOKYO_MOON["fg"], pick(palette, "on_tertiary_container", TOKYO_MOON["fg"]), 0.35)
    error_bg = mix(TOKYO_MOON["bg_highlight"], pick(palette, "error_container", TOKYO_MOON["bg_highlight"]), 0.45)
    error_fg = mix(TOKYO_MOON["fg"], pick(palette, "on_error_container", TOKYO_MOON["fg"]), 0.35)

    return {
        # Completion menus.
        "completion-menu.completion.current": f"bg:{bg_selected} {on_primary} bold",
        "completion-menu.completion": f"bg:{bg_high} {fg}",
        "completion-menu.meta.completion.current": f"bg:{bg_meta} {on_secondary}",
        "completion-menu.meta.completion": f"bg:{bg_dark} {fg_muted}",
        "completion-menu.multi-column-meta": f"bg:{bg_meta} {on_secondary}",
        "scrollbar.arrow": f"bg:{bg_dark}",
        "scrollbar": f"bg:{blue}",

        # Prompt.
        "prompt": f"{blue} bold",
        "continuation": purple,

        # Table output.
        "output.table-separator": comment,
        "output.header": f"{blue} bold",
        "output.odd-row": "",
        "output.even-row": "",
        "output.null": f"{comment} italic",
        "output.status": fg_muted,
        "output.status.warning-count": f"{red} bold",
        "output.timing": purple,

        # Selection and search.
        "selected": f"{on_secondary} bg:{bg_meta}",
        "search": f"{on_tertiary} bg:{mix(TOKYO_MOON['bg_highlight'], pick(palette, 'tertiary_container', TOKYO_MOON['bg_highlight']), 0.42)}",
        "search.current": f"{on_primary} bg:{bg_selected} bold",

        # Bottom toolbar.
        "bottom-toolbar": f"bg:{bg_dark} {fg_muted}",
        "bottom-toolbar.off": f"bg:{bg_dark} {comment}",
        "bottom-toolbar.on": f"bg:{bg_dark} {blue} bold",
        "bottom-toolbar.transaction.valid": f"bg:{bg_dark} {green} bold",
        "bottom-toolbar.transaction.failed": f"bg:{bg_dark} {red} bold",

        # Other toolbars.
        "search-toolbar": f"noinherit bold {blue}",
        "search-toolbar.text": f"nobold {fg}",
        "system-toolbar": f"noinherit bold {purple}",
        "arg-toolbar": f"noinherit bold {magenta}",
        "arg-toolbar.text": f"nobold {fg}",

        # Matching brackets.
        "matching-bracket.cursor": f"{error_fg} bg:{error_bg} bold",
        "matching-bracket.other": f"{on_secondary} bg:{bg_meta}",

        # SQL syntax highlighting overrides.
        "sql.comment": f"italic {comment}",
        "sql.comment.multi-line": f"italic {comment}",
        "sql.comment.single-line": f"italic {comment}",
        "sql.keyword": f"bold {blue}",
        "sql.datatype": purple,
        "sql.literal": cyan,
        "sql.constant": yellow,
        "sql.function": blue,
        "sql.variable": magenta,
        "sql.number": yellow,
        "sql.operator": comment,
        "sql.punctuation": fg_muted,
        "sql.string": green,
        "sql.string.escape": f"bold {orange if (orange := m('orange', 'tertiary', 0.28)) else yellow}",
    }


def build_ini(palette: dict[str, str], mix_weight: float) -> str:
    colors = build_colors(palette, mix_weight)
    lines = [
        "# mycli colors: Matugen Moon",
        "# Generated by matugen-mycli-moonmix.py.",
        "# Tokyonight Moon base, Matugen wallpaper mood. Still readable, allegedly.",
        "",
        "[colors]",
    ]
    for key, value in colors.items():
        lines.append(f"{key} = {quote(value)}")
    lines.append("")
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate a mycli Tokyonight Moon + Matugen mixed [colors] section."
    )
    parser.add_argument("--palette", required=True, type=Path, help="Matugen-generated palette JSON.")
    parser.add_argument("--output", required=True, type=Path, help="mycli colors output path.")
    parser.add_argument(
        "--mix-weight",
        type=float,
        default=0.40,
        help="Default Matugen tint weight for most colors. 0.0 = Tokyonight, 1.0 = Matugen.",
    )
    args = parser.parse_args()

    if not 0 <= args.mix_weight <= 1:
        raise SystemExit("--mix-weight must be between 0.0 and 1.0")

    palette = json.loads(args.palette.expanduser().read_text(encoding="utf-8"))
    ini = build_ini(palette, args.mix_weight)

    output = args.output.expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(ini, encoding="utf-8")


if __name__ == "__main__":
    main()
