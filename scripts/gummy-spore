#!/usr/bin/env bash
# %name: Gummy Spore
# %desc: Interactive Gum wrapper around spore
# %icon: applications-graphics-symbolic
# %terminal: true
# %categories: Utility;Development;Theme;
# %mode: noargs
# %default_args:
# %prompt:
# %tags: unclaimed-bloom spore gum theme cli
#
# @name gummy-spore
# @description Interactive Gum wrapper around spore.
# @usage gummy-spore
# @requires gum jq
# @optional spore

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_VOICE="${UB_DATA_DIR:-$REPO_DIR}/config/gummy-spore/voice.json"
PERSONAL_VOICE="${XDG_CONFIG_HOME:-$HOME/.config}/unclaimed-bloom/gummy-spore/voice.json"
GUM_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/gum/themes/unclaimed-bloom.sh"
SPORE=()
WELCOME_GREETING=""
WELCOME_SUBTITLE=""
START_OVER=0

trap 'exit 130' INT TERM

check_dependencies() {
  local command_name

  for command_name in gum jq; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      printf 'Gummy Spore needs %s, but it is not available on PATH.\n' "$command_name" >&2
      exit 1
    fi
  done
}

find_spore() {
  if command -v spore >/dev/null 2>&1; then
    SPORE=("$(command -v spore)")
    return
  fi

  if [[ -x "$REPO_DIR/scripts/spore" ]]; then
    SPORE=("$REPO_DIR/scripts/spore")
    return
  fi

  printf 'Gummy Spore could not find spore on PATH or in the repository.\n' >&2
  exit 1
}

load_theme() {
  if [[ -f "$GUM_THEME" ]]; then
    # shellcheck source=/dev/null
    source "$GUM_THEME"
  fi
}

load_voice() {
  if [[ ! -f "$DEFAULT_VOICE" ]]; then
    printf 'Gummy Spore could not find its default voice:\n  %s\n' "$DEFAULT_VOICE" >&2
    exit 1
  fi

  if [[ -f "$PERSONAL_VOICE" ]]; then
    jq -s '.[0] * .[1]' "$DEFAULT_VOICE" "$PERSONAL_VOICE"
  else
    jq '.' "$DEFAULT_VOICE"
  fi
}

random_message() {
  local voice="$1"
  local group="$2"
  local count
  local index

  count="$(jq --arg group "$group" '.[$group] | length' <<<"$voice")"
  if [[ "$count" -eq 0 ]]; then
    printf 'Gummy Spore voice group "%s" is empty.\n' "$group" >&2
    exit 1
  fi

  index=$((RANDOM % count))
  jq -r --arg group "$group" --argjson index "$index" '.[$group][$index]' <<<"$voice"
}

show_welcome() {
  local voice="$1"
  local title_line
  local greeting_line
  local subtitle_line
  local content
  local terminal_width
  local panel_width

  if [[ -z "$WELCOME_GREETING" ]]; then
    WELCOME_GREETING="$(random_message "$voice" "greetings")"
  fi
  if [[ -z "$WELCOME_SUBTITLE" ]]; then
    WELCOME_SUBTITLE="$(random_message "$voice" "subtitles")"
  fi

  terminal_width="$(tput cols 2>/dev/null || printf '80')"
  panel_width=$((terminal_width - 4))
  if ((panel_width > 68)); then
    panel_width=68
  elif ((panel_width < 32)); then
    panel_width=32
  fi

  title_line="$(gum style \
    --bold \
    --foreground "${GUM_UB_PRIMARY:-}" \
    "Gummy Spore")"
  greeting_line="$(gum style \
    --foreground "${GUM_UB_ON_SURFACE:-}" \
    "$WELCOME_GREETING")"
  subtitle_line="$(gum style \
    --faint \
    --foreground "${GUM_UB_ON_SURFACE_VARIANT:-}" \
    "$WELCOME_SUBTITLE")"

  content="$(gum join --vertical \
    "$title_line" \
    "" \
    "$greeting_line" \
    "$subtitle_line")"

  gum style \
    --no-strip-ansi \
    --border rounded \
    --border-foreground "${GUM_UB_SURFACE_VARIANT:-}" \
    --foreground "${GUM_UB_ON_SURFACE:-}" \
    --padding "1 2" \
    --margin "1 0" \
    --width "$panel_width" \
    "$content"
}

show_main_question() {
  local question="$1"

  printf '\n'
  gum style \
    --bold \
    --foreground "${GUM_UB_ON_SURFACE:-}" \
    "$question"
}

show_current_setup() {
  local status_json
  local profile_name
  local profile_json
  local profile_type
  local context_profile
  local context_json
  local base_palette
  local mood
  local target_count
  local runs
  local source_type
  local source_value
  local source_description
  local target_names
  local run_json
  local run_profile
  local run_profile_json
  local active_targets
  local run_lines
  local content
  local profile_block
  local profile_explanation
  local profile_runs
  local palette_block
  local source_block
  local mood_block
  local targets_block
  local explanation_color
  local inner_width
  local terminal_width
  local panel_width

  status_json="$("${SPORE[@]}" status --json)"
  profile_name="$(jq -r '.status.currentProfile // "desktop"' <<<"$status_json")"
  profile_json="$("${SPORE[@]}" profile show "$profile_name" --json)"
  profile_type="$(jq -r '.profile.type // "profile"' <<<"$profile_json")"

  if [[ "$profile_type" == "composition" ]]; then
    context_profile="$(jq -r '.profile.currentProfile // .profile.runs[-1].profile' <<<"$profile_json")"
    context_json="$("${SPORE[@]}" profile show "$context_profile" --json)"
    target_names=""
    run_lines=""

    while IFS= read -r run_json; do
      run_profile="$(jq -r '.profile' <<<"$run_json")"
      run_profile_json="$("${SPORE[@]}" profile show "$run_profile" --json)"
      active_targets="$(jq -nr \
        --argjson run "$run_json" \
        --argjson profile "$(jq '.profile' <<<"$run_profile_json")" \
        '$profile.targets | keys
          | if $run.targets then
              map(select(. as $target | $run.targets | index($target)))
            elif $run.exclude then
              map(select(. as $target | ($run.exclude | index($target)) == null))
            else
              .
            end
          | .[]')"
      target_names+="${active_targets}"$'\n'
      run_lines+=$'\n'
      run_lines+="- \`$run_profile\` — $(wc -l <<<"$active_targets" | tr -d ' ') target(s)"
    done < <(jq -c '.profile.runs[]' <<<"$profile_json")

    target_count="$(sed '/^$/d' <<<"$target_names" | sort -u | wc -l | tr -d ' ')"
    runs="$run_lines"
  else
    context_profile="$profile_name"
    context_json="$profile_json"
    runs=""
    target_count="$(jq -r '.profile.targets | length' <<<"$context_json")"
  fi

  base_palette="$(jq -r '.profile.basePalette' <<<"$context_json")"
  mood="$(jq -r '.profile.mood' <<<"$context_json")"
  source_type="$(jq -r '.profile.source.type' <<<"$context_json")"
  if [[ "$source_type" == "matugen" ]]; then
    source_value="$(jq -r '.profile.source.colorsPath' <<<"$context_json")"
    source_description="Wallpaper colors supplied through Matugen."
  else
    source_value="$(jq -r '.profile.source.color' <<<"$context_json")"
    source_description="A fixed seed color used instead of wallpaper colors."
  fi

  terminal_width="$(tput cols 2>/dev/null || printf '80')"
  panel_width=$((terminal_width - 4))
  if ((panel_width > 76)); then
    panel_width=76
  elif ((panel_width < 32)); then
    panel_width=32
  fi
  inner_width=$((panel_width - 6))
  explanation_color="${GUM_UB_ON_SURFACE_VARIANT:-}"

  profile_block="$(gum format <<EOF
# Current setup

Profile: **$profile_name**
EOF
)"
  if [[ "$profile_type" == "composition" ]]; then
    profile_explanation="A composition profile. It combines several profiles so different parts of the desktop can disagree politely."
    profile_runs="$(gum format "$runs")"
  else
    profile_explanation="A profile is the saved ecosystem deciding which recipes each target uses."
    profile_runs=""
  fi
  profile_block+=$'\n'
  profile_block+="$(gum style \
    --faint \
    --foreground "$explanation_color" \
    --margin "0 0 0 4" \
    --width "$inner_width" \
    "$profile_explanation")"
  if [[ -n "$profile_runs" ]]; then
    profile_block+=$'\n'
    profile_block+="$profile_runs"
  fi

  palette_block="$(gum format "Base palette: **$base_palette**")"
  palette_block+=$'\n\n'
  palette_block+="$(gum style \
    --faint \
    --foreground "$explanation_color" \
    --margin "0 0 0 4" \
    --width "$inner_width" \
    "The stable color foundation. Wallpaper colors may influence it, but they do not run the household.")"

  source_block="$(gum format "Color source: **$source_value**")"
  source_block+=$'\n\n'
  source_block+="$(gum style \
    --faint \
    --foreground "$explanation_color" \
    --margin "0 0 0 4" \
    --width "$inner_width" \
    "$source_description")"

  mood_block="$(gum format "Mood: **$mood**")"
  mood_block+=$'\n\n'
  mood_block+="$(gum style \
    --faint \
    --foreground "$explanation_color" \
    --margin "0 0 0 4" \
    --width "$inner_width" \
    "The mood controls how strongly source colors enter the bloom.")"

  targets_block="$(gum format "Targets receiving spores: **$target_count**")"
  targets_block+=$'\n\n'
  targets_block+="$(gum style \
    --faint \
    --foreground "$explanation_color" \
    --margin "0 0 0 4" \
    --width "$inner_width" \
    "Applications, tools, and desktop creatures included by this setup.")"

  content="$(gum join --vertical \
    "$profile_block" \
    "" \
    "$palette_block" \
    "" \
    "$source_block" \
    "" \
    "$mood_block" \
    "" \
    "$targets_block")"

  gum style \
    --no-strip-ansi \
    --border rounded \
    --border-foreground "${GUM_UB_SURFACE_VARIANT:-}" \
    --padding "1 2" \
    --margin "1 0" \
    --width "$panel_width" \
    "$content"

  finish_view
}

finish_view() {
  local choice

  printf '\n'
  choice="$(gum choose \
    --height=2 \
    --no-show-help \
    "Done for today" \
    "Start over")" || return 0

  if [[ "$choice" == "Start over" ]]; then
    START_OVER=1
  fi
}

show_menu() {
  local voice="$1"
  local question
  local choice

  question="$(random_message "$voice" "showQuestions")"
  printf '\n'
  gum style --bold --foreground "${GUM_UB_ON_SURFACE:-}" "$question"
  printf '\n'

  choice="$(gum choose \
    --height=5 \
    --no-show-help \
    --label-delimiter="::" \
    "Current setup             -- Profile, palette, mood::current-setup" \
    "Where the spores landed   -- Themed tools and targets::spore-targets" \
    "Current colors            -- Palette, source, bloom::current-colors" \
    "What happened last time   -- Latest lifecycle activity::last-activity" \
    "Back                      -- Main menu::back")" || return 0

  case "$choice" in
  "current-setup")
    printf '\n'
    show_current_setup
    ;;
  "back")
    return 0
    ;;
  *)
    printf '\n'
    gum style \
      --faint \
      --foreground "${GUM_UB_ON_SURFACE_VARIANT:-}" \
      "This view is still gathering its thoughts."
    ;;
  esac
}

show_action_acknowledgement() {
  local voice="$1"
  local action="$2"
  local acknowledgement="$3"
  local action_text
  local comment_text

  action_text="$(gum style \
    --bold \
    --foreground "${GUM_UB_PRIMARY:-${GUM_UB_ON_SURFACE:-}}" \
    "$action")"
  comment_text="$(gum style \
    --faint \
    --foreground "${GUM_UB_ON_SURFACE_VARIANT:-}" \
    "→  $(random_message "$voice" "$acknowledgement")")"

  gum join --horizontal "$action_text" "  " "$comment_text"
}

choose_action() {
  local voice="$1"
  local question
  local action

  question="$(random_message "$voice" "questions")"
  show_main_question "$question"
  printf '\n'

  action="$(gum choose \
    --height=4 \
    --no-show-help \
    "Change something" \
    "Show me" \
    "Remind me" \
    "Leave quietly")" || return 0

  case "$action" in
  "Show me")
    show_action_acknowledgement "$voice" "Show me" "showAcknowledgements"
    show_menu "$voice"
    ;;
  "Leave quietly")
    return 0
    ;;
  *)
    printf '\n'
    gum style \
      --faint \
      --foreground "${GUM_UB_ON_SURFACE_VARIANT:-}" \
      "You chose: $action. This path is still growing."
    ;;
  esac
}

main() {
  local voice

  printf '\033[2J\033[H'
  check_dependencies
  find_spore
  load_theme
  voice="$(load_voice)"
  show_welcome "$voice"

  while true; do
    START_OVER=0
    choose_action "$voice"
    if ((START_OVER == 0)); then
      break
    fi

    printf '\033[2J\033[H'
    show_welcome "$voice"
  done
}

main "$@"
