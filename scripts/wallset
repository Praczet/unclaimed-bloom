#!/usr/bin/env bash
# %name: wallset
# %desc: Pick or pass a wallpaper, then hand it to Unclaimed Bloom.
# %icon: preferences-desktop-wallpaper-symbolic
# %terminal: true

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WALLPAPER_DIR="${UB_WALLPAPER_DIR:-$HOME/.config/backgrounds}"
BACKEND="${UB_WALLSET_BACKEND:-${UB_WALSET_BACKEND:-$REPO_DIR/scripts/wallset-backend}}"

usage() {
  cat <<EOF
Usage: wallset [wallpaper]

If wallpaper is omitted, wallset opens Qreep's wallpaper picker (which calls
wallset again with the chosen path). Without Qreep it picks from:
  $WALLPAPER_DIR
with fuzzel or fzf.

Environment:
  UB_WALLPAPER_DIR       Wallpaper picker directory
  UB_WALLSET_BACKEND     Backend command/script
  UB_WALLSET_PROFILE     Profile/composition override

Saved profile:
  spore profile use <name>
EOF
}

pick_wallpaper() {
  local dir="$1"
  [[ -d "$dir" ]] || {
    echo "Wallpaper directory not found:" >&2
    echo "  $dir" >&2
    exit 1
  }

  local selected=""

  selected="$(
    find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
      -printf '%f\n' |
      sort |
      text_pick || true
  )"

  [[ -n "$selected" ]] || {
    echo "No wallpaper selected." >&2
    exit 1
  }

  printf '%s/%s\n' "$dir" "$selected"
}

text_pick() {
  if command -v fuzzel >/dev/null 2>&1; then
    fuzzel --dmenu --prompt "wallpaper> "
  elif command -v fzf >/dev/null 2>&1; then
    fzf
  else
    sed -n '1p'
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

wallpaper="${1:-}"
if [[ -z "$wallpaper" ]]; then
  # Qreep's picker applies through wallset <path>, so this run is done.
  if quickshell ipc -c qreep call qreep-wallpaper showMe >/dev/null 2>&1; then
    exit 0
  fi
  wallpaper="$(pick_wallpaper "$WALLPAPER_DIR")"
fi

exec "$BACKEND" "$wallpaper"
