#!/usr/bin/env bash
# %name: Unclaimed Bloom
# %desc: Start the Unclaimed Bloom workbench and open it in a browser.
# %icon: applications-graphics-symbolic
# %terminal: true

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${UB_WORKBENCH_PORT:-7865}"
URL="http://127.0.0.1:$PORT"
LOGFILE="${UB_WORKBENCH_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/unclaimed-bloom/workbench.log}"
OPEN_BROWSER="${UB_OPEN_BROWSER:-1}"

mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true

if ! { touch "$LOGFILE" && [[ -w "$LOGFILE" ]]; } 2>/dev/null; then
    LOGFILE="${TMPDIR:-/tmp}/unclaimed-bloom-workbench.log"
    touch "$LOGFILE"
fi

open_browser() {
    [[ "$OPEN_BROWSER" == "0" ]] && return 0
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$URL" >/dev/null 2>&1 &
    elif command -v gio >/dev/null 2>&1; then
        gio open "$URL" >/dev/null 2>&1 &
    else
        echo "No browser opener found. Open manually: $URL"
    fi
}

wait_for_workbench() {
    for _ in {1..80}; do
        if curl -fsS "$URL" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done
    echo "Workbench did not answer at $URL — it may still be starting."
}

if curl -fsS "$URL" >/dev/null 2>&1; then
    echo "Workbench already running at $URL"
    open_browser
    exit 0
fi

echo "Starting Unclaimed Bloom workbench"
echo "  url: $URL"
echo "  log: $LOGFILE"

cd "$REPO_DIR"
deno task workbench >"$LOGFILE" 2>&1 &
SERVER_PID=$!

cleanup() {
    kill "$SERVER_PID" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

wait_for_workbench
open_browser

echo "Workbench running. Press Ctrl+C to stop."
wait "$SERVER_PID"
