#!/usr/bin/env bash
# %name: Unclaimed Bloom
# %desc: Start the Unclaimed Bloom workbench and open it in a browser.
# %icon: applications-graphics-symbolic
# %terminal: true

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UI_PORT="${UB_WORKBENCH_UI_PORT:-5173}"
URL="${UB_WORKBENCH_URL:-http://localhost:$UI_PORT}"
LOGFILE="${UB_WORKBENCH_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/unclaimed-bloom/workbench.log}"
OPEN_BROWSER="${UB_OPEN_BROWSER:-1}"

mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true

if ! { touch "$LOGFILE" && [[ -w "$LOGFILE" ]]; } 2>/dev/null; then
    LOGFILE="${TMPDIR:-/tmp}/unclaimed-bloom-workbench.log"
    mkdir -p "$(dirname "$LOGFILE")"
    touch "$LOGFILE"
fi

open_browser() {
    if [[ "$OPEN_BROWSER" == "0" ]]; then
        return 0
    fi

    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$URL" >/dev/null 2>&1 &
    elif command -v gio >/dev/null 2>&1; then
        gio open "$URL" >/dev/null 2>&1 &
    else
        echo "No browser opener found. Open manually: $URL"
    fi
}

wait_for_workbench() {
    for _ in {1..80}; do
        if command -v curl >/dev/null 2>&1 && curl -fsS "$URL" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done

    echo "Workbench did not answer quickly. It may still be starting."
    echo "URL: $URL"
}

workbench_is_running() {
    command -v curl >/dev/null 2>&1 && curl -fsS "$URL" >/dev/null 2>&1
}

cd "$REPO_DIR"

if [[ ! -x "$REPO_DIR/node_modules/.bin/vite" || ! -x "$REPO_DIR/node_modules/.bin/tsx" ]]; then
    echo "Missing node dependencies. Run npm install in:"
    echo "  $REPO_DIR"
    exit 1
fi

echo "Starting Unclaimed Bloom workbench"
echo "  url: $URL"
echo "  log: $LOGFILE"

if workbench_is_running; then
    echo "Workbench already answers at $URL"
    open_browser
    exit 0
fi

npm run workbench >"$LOGFILE" 2>&1 &
SERVER_PID=$!

cleanup() {
    if kill -0 "$SERVER_PID" >/dev/null 2>&1; then
        kill "$SERVER_PID" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT INT TERM

wait_for_workbench
open_browser

echo "Workbench running. Press Ctrl+C to stop."
wait "$SERVER_PID"
