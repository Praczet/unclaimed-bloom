#!/usr/bin/env python3
# %name: ub-splice-block
# %desc: Replace a marked, generated block inside a hand-written file (e.g. Logseq custom.css).
# %icon: palette
# %terminal: true
# %categories: theme
# %usage: ub-splice-block <target-file> <rendered-file> [block-name]
# %safe: yes
"""
Keeps everything outside the markers untouched:

    /* >>> unclaimed-bloom >>> generated by spore, edits inside are overwritten */
    ...rendered content...
    /* <<< unclaimed-bloom <<< */

The block is appended on first run. The file is only rewritten when the block
actually changes, so planting the same colours twice leaves no diff behind.
"""

import os
import sys
import tempfile
from pathlib import Path


def main() -> int:
    if len(sys.argv) not in (3, 4):
        print("usage: ub-splice-block <target-file> <rendered-file> [block-name]", file=sys.stderr)
        return 2

    target = Path(sys.argv[1]).expanduser()
    rendered = Path(sys.argv[2]).expanduser()
    name = sys.argv[3] if len(sys.argv) == 4 else "unclaimed-bloom"

    if not rendered.is_file():
        print(f"ub-splice-block: rendered file not found: {rendered}", file=sys.stderr)
        return 1
    if not target.parent.is_dir():
        print(f"ub-splice-block: target folder not found: {target.parent}", file=sys.stderr)
        return 1

    start = f"/* >>> {name} >>> generated by spore, edits inside are overwritten */"
    end = f"/* <<< {name} <<< */"
    block = f"{start}\n{rendered.read_text().strip()}\n{end}"

    current = target.read_text() if target.exists() else ""
    head, sep, rest = current.partition(start)
    if sep:
        _, end_sep, tail = rest.partition(end)
        if not end_sep:
            print(f"ub-splice-block: found '{start}' but no closing marker in {target}", file=sys.stderr)
            return 1
        updated = f"{head}{block}{tail}"
    else:
        updated = f"{current.rstrip()}\n\n{block}\n" if current.strip() else f"{block}\n"

    if updated == current:
        print(f"ub-splice-block: {target} unchanged")
        return 0

    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    with os.fdopen(fd, "w") as handle:
        handle.write(updated)
    if target.exists():
        os.chmod(tmp, target.stat().st_mode & 0o777)
    os.replace(tmp, target)
    print(f"ub-splice-block: updated block '{name}' in {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
