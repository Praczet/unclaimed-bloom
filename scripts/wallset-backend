#!/usr/bin/env bash
# %name: wallset-backend
# %desc: Grow Unclaimed Bloom from a wallpaper through the desktop composition.
# %icon: seedling
# %terminal: true

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPORE="${UB_WALLSET_SPORE:-${UB_WALSET_SPORE:-$REPO_DIR/scripts/spore}}"
CACHE_DIR="${UB_CACHE_DIR:-$HOME/.cache/unclaimed-bloom}"
CURRENT_PROFILE_FILE="$CACHE_DIR/current-profile"

resolve_profile() {
    if [[ -n "${UB_WALLSET_PROFILE:-${UB_WALSET_PROFILE:-}}" ]]; then
        printf '%s\n' "${UB_WALLSET_PROFILE:-${UB_WALSET_PROFILE:-}}"
        return
    fi

    if profile="$("$SPORE" profile current 2>/dev/null)" && [[ -n "$profile" ]]; then
        printf '%s\n' "$profile"
        return
    fi

    if [[ -f "$CURRENT_PROFILE_FILE" ]]; then
        profile="$(tr -d '[:space:]' < "$CURRENT_PROFILE_FILE")"
        if [[ -n "$profile" ]]; then
            printf '%s\n' "$profile"
            return
        fi
    fi

    printf '%s\n' "desktop"
}

PROFILE="$(resolve_profile)"

# Matugen mode (dark|light) for the wallpaper: the source.variant of the
# profile (for a composition, of its currentProfile). Defaults to dark.
resolve_matugen_mode() {
    if [[ -n "${UB_WALLSET_MATUGEN_MODE:-}" ]]; then
        printf '%s\n' "$UB_WALLSET_MATUGEN_MODE"
        return
    fi
    "$SPORE" profile show "$PROFILE" --json 2>/dev/null | python3 -I -c '
import json, subprocess, sys
spore, profile = sys.argv[1], sys.argv[2]
try:
    p = json.load(sys.stdin)["profile"]
    if p.get("type") == "composition":
        out = subprocess.run([spore, "profile", "show", p["currentProfile"], "--json"],
                             capture_output=True, text=True, check=True).stdout
        p = json.loads(out)["profile"]
    print("light" if p["source"]["variant"] == "light" else "dark")
except Exception:
    print("dark")
' "$SPORE" "$PROFILE" || printf '%s\n' "dark"
}

usage() {
    cat <<EOF
Usage: wallset-backend <wallpaper>

Runs:
  matugen-cache <wallpaper> <dark|light>
  spore sow <profile> --wallpaper <wallpaper> --bloom-osd
  spore grow <profile>
  spore plant <profile> --bloom-osd

Default profile:
  $PROFILE

Environment:
  UB_WALLSET_PROFILE       Profile/composition override
  UB_WALLSET_SPORE         spore command/script
  UB_WALLSET_MATUGEN_MODE  dark|light override (default: profile source.variant)

Saved profile:
  spore profile use <name>
  current file: $CURRENT_PROFILE_FILE
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

wallpaper="${1:-}"
if [[ -z "$wallpaper" ]]; then
    usage >&2
    exit 1
fi

if [[ ! -f "$wallpaper" ]]; then
    echo "Wallpaper file not found:" >&2
    echo "  $wallpaper" >&2
    exit 1
fi

CURRENT_WALLPAPER_FILE="$CACHE_DIR/current-wallpaper"
LOCK_FILE="$CACHE_DIR/wallset.lock"
mkdir -p "$CACHE_DIR"

# Recursively kill a process and all its descendants
kill_tree() {
    local pid=$1
    local children
    children=$(pgrep -P "$pid" 2>/dev/null || true)
    for child in $children; do
        kill_tree "$child"
    done
    kill -TERM "$pid" 2>/dev/null || true
}

# Kill any previous wallset-backend run so only one runs at a time
if [[ -f "$LOCK_FILE" ]]; then
    OLD_PID=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
    if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "Stopping previous run (pid $OLD_PID)..."
        kill_tree "$OLD_PID"
        sleep 0.3
        # Force-kill anything that didn't respond to TERM
        pgrep -P "$OLD_PID" 2>/dev/null | xargs -r kill -KILL 2>/dev/null || true
        kill -KILL "$OLD_PID" 2>/dev/null || true
    fi
    rm -f "$LOCK_FILE"
fi

echo "$$" > "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

echo "Unclaimed Bloom wallpaper run"
echo "  profile:   $PROFILE"
echo "  wallpaper: $wallpaper"

# Write current-wallpaper before sow so grow can inject it into templates
echo "$wallpaper" > "$CURRENT_WALLPAPER_FILE"

# Regenerate the Matugen source colours from this wallpaper. `spore sow
# --wallpaper` only passes the path to the bloom OSD; it does not run Matugen,
# so without this step every bloom reuses the last cached wallpaper's colours.
# A Matugen failure stops the run instead of planting stale colours.
MATUGEN_MODE="$(resolve_matugen_mode)"
echo "  matugen:   $MATUGEN_MODE"
UB_CACHE_DIR="$CACHE_DIR" "$REPO_DIR/scripts/matugen-cache" "$wallpaper" "$MATUGEN_MODE"

"$SPORE" sow "$PROFILE" --wallpaper "$wallpaper" --bloom-osd
"$SPORE" grow "$PROFILE"

# Set wallpaper first so the desktop changes immediately while the rest plants
if ! pgrep -x awww-daemon > /dev/null 2>&1; then
    awww-daemon &
    sleep 0.5
fi
awww img "$wallpaper" --transition-type fade

"$SPORE" plant "$PROFILE" --bloom-osd
