#!/usr/bin/env python3
# %name: superfile-select-theme
# %desc: Select a Superfile theme without disturbing the rest of config.toml.
# %icon: palette
# %terminal: true
# %categories: theme
# %usage: superfile-select-theme <theme-name> [config-file]
# %safe: yes

import os
import re
import sys
import tempfile
from pathlib import Path


def main() -> int:
    if len(sys.argv) not in (2, 3):
        print(
            "usage: superfile-select-theme <theme-name> [config-file]",
            file=sys.stderr,
        )
        return 2

    theme = sys.argv[1]
    config = Path(sys.argv[2] if len(sys.argv) == 3 else "~/.config/superfile/config.toml").expanduser()

    if not re.fullmatch(r"[A-Za-z0-9._-]+", theme):
        print(f"superfile-select-theme: invalid theme name: {theme}", file=sys.stderr)
        return 2
    if not config.is_file():
        print(
            f"superfile-select-theme: config not found: {config}\n"
            "Start Superfile once so it can create its config, then plant again.",
            file=sys.stderr,
        )
        return 1

    current = config.read_text()
    setting = f'theme = "{theme}"'
    pattern = re.compile(r"(?m)^\s*theme\s*=\s*(['\"]).*?\1\s*(?:#.*)?$")
    updated, count = pattern.subn(setting, current, count=1)
    if count == 0:
        updated = f"{setting}\n{current}"

    if updated == current:
        print(f"superfile-select-theme: {config} already selects {theme}")
        return 0

    fd, temporary = tempfile.mkstemp(dir=config.parent, prefix=f".{config.name}.")
    with os.fdopen(fd, "w") as handle:
        handle.write(updated)
    os.chmod(temporary, config.stat().st_mode & 0o777)
    os.replace(temporary, config)
    print(f"superfile-select-theme: selected {theme} in {config}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
