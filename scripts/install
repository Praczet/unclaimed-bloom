#!/usr/bin/env bash
# %name: install
# %desc: Install the spore launcher and first-run data files.
# %icon: seedling
# %terminal: true

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
CONFIG_DIR="${UB_INSTALL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/unclaimed-bloom}"
COMPLETIONS_DIR="${UB_INSTALL_COMPLETIONS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh/completions}"
SPORE_BIN="${SPORE_BIN:-$BIN_DIR/spore}"
WORKBENCH_BIN="${WORKBENCH_BIN:-$BIN_DIR/unclaimed-bloom}"
FORCE=0

usage() {
    cat <<EOF
Usage: scripts/install [--force]

Installs:
  spore launcher:      $SPORE_BIN
  workbench launcher:  $WORKBENCH_BIN
  data files:          $CONFIG_DIR
  zsh completions:     $COMPLETIONS_DIR

Environment overrides:
  BIN_DIR
  SPORE_BIN
  WORKBENCH_BIN
  UB_INSTALL_CONFIG_DIR
  UB_INSTALL_COMPLETIONS_DIR

Use --force to overwrite existing installed data files.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force)
            FORCE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

copy_dir() {
    local name="$1"
    local src="$REPO_DIR/$name"
    local dst="$CONFIG_DIR/$name"

    [[ -d "$src" ]] || return 0

    if [[ -e "$dst" && "$FORCE" -ne 1 ]]; then
        echo "  keep $dst"
        return 0
    fi

    mkdir -p "$(dirname "$dst")"
    if [[ "$FORCE" -eq 1 ]]; then
        rm -rf "$dst"
    fi
    mkdir -p "$dst"
    (cd "$src" && tar --exclude='.ai' -cf - .) | (cd "$dst" && tar -xf -)
    echo "  copy $name -> $dst"
}

install_launcher() {
    mkdir -p "$(dirname "$SPORE_BIN")"
    cat > "$SPORE_BIN" <<EOF
#!/usr/bin/env bash
# Generated by Unclaimed Bloom / scripts/install.

set -euo pipefail

REPO_DIR="$REPO_DIR"
export UB_DATA_DIR="\${UB_DATA_DIR:-$CONFIG_DIR}"
export UB_CACHE_DIR="\${UB_CACHE_DIR:-\${XDG_CACHE_HOME:-\$HOME/.cache}/unclaimed-bloom}"

if [[ -f "\$REPO_DIR/dist/cli/spore.js" ]]; then
    exec node "\$REPO_DIR/dist/cli/spore.js" "\$@"
fi

if [[ -x "\$REPO_DIR/node_modules/.bin/tsx" ]]; then
    exec "\$REPO_DIR/node_modules/.bin/tsx" "\$REPO_DIR/src/cli/spore.ts" "\$@"
fi

echo "spore is installed, but neither dist/cli/spore.js nor node_modules/.bin/tsx exists." >&2
echo "Run npm install in: \$REPO_DIR" >&2
exit 1
EOF
    chmod +x "$SPORE_BIN"
    echo "  launcher -> $SPORE_BIN"
}

install_workbench_launcher() {
    mkdir -p "$(dirname "$WORKBENCH_BIN")"
    cat > "$WORKBENCH_BIN" <<EOF
#!/usr/bin/env bash
# Generated by Unclaimed Bloom / scripts/install.

set -euo pipefail

REPO_DIR="$REPO_DIR"
export UB_DATA_DIR="\${UB_DATA_DIR:-$CONFIG_DIR}"
export UB_CACHE_DIR="\${UB_CACHE_DIR:-\${XDG_CACHE_HOME:-\$HOME/.cache}/unclaimed-bloom}"

exec "\$REPO_DIR/scripts/unclaimed-bloom" "\$@"
EOF
    chmod +x "$WORKBENCH_BIN"
    echo "  launcher -> $WORKBENCH_BIN"
}

install_completions() {
    [[ -d "$REPO_DIR/completions" ]] || return 0
    mkdir -p "$COMPLETIONS_DIR"
    cp "$REPO_DIR"/completions/_* "$COMPLETIONS_DIR"/
    echo "  completions -> $COMPLETIONS_DIR"
}

mkdir -p "$CONFIG_DIR"

echo "Installing Unclaimed Bloom"
install_launcher
install_workbench_launcher
copy_dir palettes
copy_dir moods
copy_dir profiles
copy_dir targets
copy_dir scripts
install_completions

cat <<EOF

Done.

Make sure this is on PATH:
  $BIN_DIR

For zsh completions, add this before compinit if needed:
  fpath=($COMPLETIONS_DIR \$fpath)
EOF
